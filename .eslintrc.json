{
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
    "no-console": "off",
    "no-undef": "off",
    "semi": ["error", "always"],
    "quotes": ["error", "single", { "avoidEscape": true }]
  },
  "globals": {
    "auth_sync": "readonly",
    "triggerHapticFeedback": "readonly",
    "toggleSidebarPin": "readonly",
    "openFeedbackForm": "readonly",
    "confirmDataReset": "readonly",
    "openAccountSettings": "readonly",
    "closeAccountSettings": "readonly",
    "showConfirm": "readonly",
    "closeConfirm": "readonly"
  },
  "gitlens.codeLens.enabled": false,
  "gitlens.currentLine.enabled": true,
  "gitlens.currentLine.format": "${author}, ${date} • ${message}",
  "gitlens.advanced.suppressShowWhatsNewNotice": true,
  "gitlens.advanced.suppressWelcomeNotice": true,
  "gitlens.hovers.enabled": true
}